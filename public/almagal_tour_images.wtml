  <!-- #29 in almagal_sources_wwt_matches.wtml - NGC 3372 -->
  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noaoann07017a&quot;, &quot;publishedUTCISO8601&quot;: &quot;2007-04-27T18:00:00+00:00&quot;}" Constellation="CAR" DataSetType="Sky" Dec="-59.59650472839565" Magnitude="0" Name="NGC 3372" Opacity="100" RA="10.741333627872812" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noaoann07017a/thumb.jpg" ZoomLevel="2.0257541749449377">
    <Description>Hubble&amp;#x27;s view of the Carina Nebula shows star birth in a new level of detail. The fantasy-like landscape of the nebula is sculpted by the action of outflowing winds and scorching ultraviolet radiation from the monster stars that inhabit this inferno. In the process, these stars are shredding the surrounding material that is the last vestige of the giant cloud from which the stars were born. The immense nebula is an estimated 7,500 light-years away in the southern constellation Carina the Keel (of the old southern constellation Argo Navis, the ship of Jason and the Argonauts, from Greek mythology). This image is a mosaic of the Carina Nebula assembled from 48 frames taken with Hubble Space Telescope&amp;#x27;s Advanced Camera for Surveys. The Hubble images were taken in the light of ionized hydrogen. Colour information was added with data taken at the Cerro Tololo Inter-American Observatory in Chile. Red corresponds to sulfur, green to hydrogen, and blue to oxygen emission.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.4544259890151424" BaseTileLevel="0" BottomsUp="False" CenterX="161.120000825" CenterY="-59.5965242562" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="NGC 3372" OffsetX="1.38679806218e-05" OffsetY="1.38679806218e-05" Projection="Tan" QuadTreeMap="" Rotation="50.32000000000004" Sparse="True" StockSet="False" TileLevels="7" Url="http://data1.wwtassets.org/feeds/noirlab/noaoann07017a/L{1}X{2}Y{3}.png" WidthFactor="2" Xcxstatus="in:642762f9975014bc743f1779">
        <Credits>Hubble Image: NASA, ESA, N. Smith (University of California, Berkeley), and The Hubble Heritage Team (STScI/AURA);CTIO Image: N. Smith (University of California, Berkeley) and NOAO/AURA/NSF</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/noaoann07017a/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/noirlab/noaoann07017a/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
