        <CreditsUrl>https://www.eso.org/public/images/potw2003a/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/eso/potw2003a/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
