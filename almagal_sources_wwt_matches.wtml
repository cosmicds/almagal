        <CreditsUrl>https://www.eso.org/public/images/potw2113a/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/eso/potw2113a/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
