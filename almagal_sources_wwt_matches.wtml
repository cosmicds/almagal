  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-02174&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:34:03+00:00&quot;}" Constellation="CAR" DataSetType="Sky" Dec="-59.642452288499435" Magnitude="0" Name="The Eta Carinae nebula, NGC 3372" Opacity="100" RA="10.74671410020898" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-02174/thumb.jpg" ZoomLevel="3.6940014000000003">
    <Description>The central portion of the Eta Carinae Nebula, NGC 3372, also known as the Keyhole Nebula, in the constellation of Carina. This gaseous bright nebula surrounds the peculiar variable star Eta Carinae, with overlying clouds of dark material. The nebula is 9000 light-years from Earth. Cerro Tololo 4-meter Blanco telescope, 1976: north is at the top.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.749568" BaseTileLevel="0" BottomsUp="False" CenterX="161.3725992" CenterY="-59.69848767" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="The Eta Carinae nebula, NGC 3372" OffsetX="0.09544889414060001" OffsetY="0.03954082809869999" Projection="Tan" QuadTreeMap="" Rotation="10.324113132727" Sparse="True" StockSet="False" TileLevels="4" Url="http://data1.wwtassets.org/feeds/noirlab/noao-02174/L{1}X{2}Y{3}.png" WidthFactor="2" Xcxstatus="in:64276266975014bc743f1641">
